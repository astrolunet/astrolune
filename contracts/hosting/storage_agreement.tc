// StorageAgreement - on-chain storage contracts between clients and providers.
//
// Clients create agreements specifying storage terms, duration, replication
// factor, and payment. Providers accept and fulfill agreements. Either party
// may raise a dispute which the contract owner mediates.
//
// Agreement statuses:
//   0 = pending   (created, awaiting provider acceptance)
//   1 = active    (provider accepted, storage in progress)
//   2 = completed (duration elapsed, successful fulfillment)
//   3 = disputed  (either party raised a dispute)
//   4 = resolved  (owner resolved the dispute)
//
// Compile:
//     trocto contracts/hosting/storage_agreement.tc -o storage_agreement.bin
//     trocto contracts/hosting/storage_agreement.tc --emit-regol

contract StorageAgreement {
    state {
        owner: address,
        agreement_count: u64,
        agreements: map<u64,u64>,
        provider_agreements: map<u64,u64>,
        agreement_client: map<u64,u64>,
        agreement_provider_addr: map<u64,u64>,
        agreement_status: map<u64,u64>,
        agreement_start: map<u64,u64>,
        agreement_duration: map<u64,u64>,
        agreement_replication: map<u64,u64>,
        agreement_payment: map<u64,u64>,
        agreement_storage_key: map<u64,u64>,
        agreement_dispute_reason: map<u64,u64>,
    }

    event AgreementCreated {
        agreement_id: u64,
        client: address,
        provider: address,
        payment: u64,
        duration: u64,
    }

    event AgreementCompleted {
        agreement_id: u64,
        client: address,
        provider: address,
    }

    event AgreementDisputed {
        agreement_id: u64,
        disputer: address,
        reason: u64,
    }

    event AgreementResolved {
        agreement_id: u64,
        outcome: u64,
    }

    // Constructor: sets deployer as contract owner.
    init() {
        self.owner = sender();
        self.agreement_count = 0;
    }

    // Create a new storage agreement. Client calls this and sends payment.
    // provider: address of the storage provider
    // duration: number of blocks the agreement lasts
    // replication: number of replicas the provider must maintain
    // storage_key: identifier for the data being stored
    // Returns the agreement_id.
    pub fn create_agreement(provider: address, duration: u64, replication: u64, storage_key: u64) -> u64 {
        require(provider != 0, 1);
        require(duration > 0, 2);
        require(replication > 0, 3);
        require(storage_key != 0, 4);
        let payment = caller_balance();
        require(payment > 0, 5);
        let agreement_id = self.agreement_count + 1;
        self.agreement_count = agreement_id;
        agreement_client[agreement_id] = sender();
        agreement_provider_addr[agreement_id] = provider;
        agreement_status[agreement_id] = 0;
        agreement_start[agreement_id] = height();
        agreement_duration[agreement_id] = duration;
        agreement_replication[agreement_id] = replication;
        agreement_payment[agreement_id] = payment;
        agreement_storage_key[agreement_id] = storage_key;
        provider_agreements[provider] = agreement_id;
        emit AgreementCreated(agreement_id, sender(), provider, payment, duration);
        return agreement_id;
    }

    // Provider accepts an agreement. Only the registered provider may call.
    // Sets status to active.
    pub fn accept_agreement(agreement_id: u64) {
        let provider = agreement_provider_addr[agreement_id];
        require(provider != 0, 6);
        require(agreement_status[agreement_id] == 0, 7);
        require(sender() == provider, 8);
        agreement_status[agreement_id] = 1;
    }

    // Complete an agreement. Either client or provider may call once duration
    // has elapsed. Pays the provider and marks agreement as completed.
    pub fn complete_agreement(agreement_id: u64) {
        require(agreement_status[agreement_id] == 1, 9);
        let caller = sender();
        let client = agreement_client[agreement_id];
        let provider = agreement_provider_addr[agreement_id];
        require((caller == client) || (caller == provider), 10);
        let start = agreement_start[agreement_id];
        let duration = agreement_duration[agreement_id];
        require(height() >= start + duration, 11);
        let payment = agreement_payment[agreement_id];
        pay(provider, payment);
        agreement_status[agreement_id] = 2;
        emit AgreementCompleted(agreement_id, client, provider);
    }

    // Raise a dispute on an agreement. Either client or provider may call.
    // reason: encoded reason code (1=non-payment, 2=data-loss, 3=sla-violation, 4=other)
    pub fn raise_dispute(agreement_id: u64, reason: u64) {
        require((agreement_status[agreement_id] == 0) || (agreement_status[agreement_id] == 1), 12);
        require(reason > 0, 13);
        let caller = sender();
        let client = agreement_client[agreement_id];
        let provider = agreement_provider_addr[agreement_id];
        require((caller == client) || (caller == provider), 10);
        agreement_status[agreement_id] = 3;
        agreement_dispute_reason[agreement_id] = reason;
        emit AgreementDisputed(agreement_id, caller, reason);
    }

    // Resolve a dispute. Only the contract owner may call.
    // outcome: 1 = client wins (full refund), 2 = provider wins (pay provider),
    //          3 = split (half refund, half pay)
    pub fn resolve_dispute(agreement_id: u64, outcome: u64) {
        require(sender() == self.owner, 14);
        require(agreement_status[agreement_id] == 3, 15);
        require((outcome >= 1) && (outcome <= 3), 16);
        let payment = agreement_payment[agreement_id];
        let client = agreement_client[agreement_id];
        let provider = agreement_provider_addr[agreement_id];
        if (outcome == 1) {
            pay(client, payment);
        }
        if (outcome == 2) {
            pay(provider, payment);
        }
        if (outcome == 3) {
            let half = payment / 2;
            pay(client, half);
            pay(provider, payment - half);
        }
        agreement_status[agreement_id] = 4;
        emit AgreementResolved(agreement_id, outcome);
    }

    // Get the client address of an agreement.
    pub fn get_client(agreement_id: u64) -> address {
        return agreement_client[agreement_id];
    }

    // Get the provider address of an agreement.
    pub fn get_provider(agreement_id: u64) -> address {
        return agreement_provider_addr[agreement_id];
    }

    // Get agreement status.
    pub fn get_status(agreement_id: u64) -> u64 {
        return agreement_status[agreement_id];
    }

    // Get agreement start height.
    pub fn get_start(agreement_id: u64) -> u64 {
        return agreement_start[agreement_id];
    }

    // Get agreement duration.
    pub fn get_duration(agreement_id: u64) -> u64 {
        return agreement_duration[agreement_id];
    }

    // Get agreement replication factor.
    pub fn get_replication(agreement_id: u64) -> u64 {
        return agreement_replication[agreement_id];
    }

    // Get agreement payment amount.
    pub fn get_payment(agreement_id: u64) -> u64 {
        return agreement_payment[agreement_id];
    }

    // Get storage key.
    pub fn get_storage_key(agreement_id: u64) -> u64 {
        return agreement_storage_key[agreement_id];
    }

    // Get dispute reason.
    pub fn get_dispute_reason(agreement_id: u64) -> u64 {
        return agreement_dispute_reason[agreement_id];
    }

    // Get total number of agreements.
    pub fn get_agreement_count() -> u64 {
        return self.agreement_count;
    }

    // Check if an agreement is expired. Returns 1 if expired, 0 otherwise.
    pub fn is_expired(agreement_id: u64) -> u64 {
        let status = agreement_status[agreement_id];
        if (status != 1) {
            return 0;
        }
        let start = agreement_start[agreement_id];
        let duration = agreement_duration[agreement_id];
        if (height() >= start + duration) {
            return 1;
        }
        return 0;
    }
}
