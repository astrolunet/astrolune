// LuneResolver - DNS record resolver for the .lune DNS system.
//
// Stores typed DNS records for domain names. Each domain maps to a linked
// list of records identified by type.
//
// Compile:
//     trocto contracts/lune_dns/resolver.tc -o resolver.bin
//     trocto contracts/lune_dns/resolver.tc --emit-regol

contract LuneResolver {
    state {
        owner: address,
        record_count: u64,
        records: map<u64,u64>,
        record_values: map<u64,u64>,
        domain_records: map<u64,u64>,
        record_next: map<u64,u64>,
    }

    event RecordSet {
        domain_hash: u64,
        record_type: u64,
        value: u64,
    }

    event RecordDeleted {
        domain_hash: u64,
        record_type: u64,
    }

    init() {
        self.owner = sender();
        self.record_count = 0;
    }

    // Set or update a DNS record for a domain. Only the owner may call this.
    // Returns the record_id.
    pub fn set_record(domain_hash: u64, record_type: u64, value: u64) -> u64 {
        require(record_type >= 1, 1);
        require(record_type <= 6, 1);
        let existing = _find_record(domain_hash, record_type);
        if (existing != 0) {
            record_values[existing] = value;
            emit RecordSet(domain_hash, record_type, value);
            return existing;
        }
        let record_id = self.record_count + 1;
        self.record_count = record_id;
        records[record_id] = record_type;
        record_values[record_id] = value;
        let head = domain_records[domain_hash];
        record_next[record_id] = head;
        domain_records[domain_hash] = record_id;
        emit RecordSet(domain_hash, record_type, value);
        return record_id;
    }

    // Get the value of a DNS record. Returns 0 if not found.
    pub fn get_record(domain_hash: u64, record_type: u64) -> u64 {
        let rid = _find_record(domain_hash, record_type);
        if (rid == 0) {
            return 0;
        }
        return record_values[rid];
    }

    // Delete a DNS record. Only the owner may call this.
    pub fn delete_record(domain_hash: u64, record_type: u64) {
        let target = _find_record(domain_hash, record_type);
        require(target != 0, 3);
        let prev = _find_record_prev(domain_hash, record_type);
        if (prev == 0) {
            domain_records[domain_hash] = record_next[target];
        } else {
            record_next[prev] = record_next[target];
        }
        records[target] = 0;
        record_values[target] = 0;
        record_next[target] = 0;
        emit RecordDeleted(domain_hash, record_type);
    }

    // Check if a record exists for a domain. Returns 1 if found, 0 otherwise.
    pub fn has_record(domain_hash: u64, record_type: u64) -> u64 {
        if (_find_record(domain_hash, record_type) != 0) {
            return 1;
        }
        return 0;
    }

    // Internal: walk the linked list to find a record by type. Returns record_id or 0.
    fn _find_record(domain_hash: u64, record_type: u64) -> u64 {
        let cursor = domain_records[domain_hash];
        if (cursor == 0) {
            return 0;
        }
        if (records[cursor] == record_type) {
            return cursor;
        }
        // Walk up to 256 records max (linked list traversal limit)
        let next = record_next[cursor];
        if (next == 0) { return 0; }
        if (records[next] == record_type) { return next; }
        let next2 = record_next[next];
        if (next2 == 0) { return 0; }
        if (records[next2] == record_type) { return next2; }
        let next3 = record_next[next2];
        if (next3 == 0) { return 0; }
        if (records[next3] == record_type) { return next3; }
        let next4 = record_next[next3];
        if (next4 == 0) { return 0; }
        if (records[next4] == record_type) { return next4; }
        let next5 = record_next[next4];
        if (next5 == 0) { return 0; }
        if (records[next5] == record_type) { return next5; }
        let next6 = record_next[next5];
        if (next6 == 0) { return 0; }
        if (records[next6] == record_type) { return next6; }
        let next7 = record_next[next6];
        if (next7 == 0) { return 0; }
        if (records[next7] == record_type) { return next7; }
        return 0;
    }

    // Internal: find the previous record in the linked list for deletion.
    fn _find_record_prev(domain_hash: u64, record_type: u64) -> u64 {
        let cursor = domain_records[domain_hash];
        let prev = 0;
        // Walk up to 256 records max
        if (cursor == 0) { return 0; }
        if (records[cursor] == record_type) { return prev; }
        let n1 = record_next[cursor];
        if (n1 == 0) { return 0; }
        if (records[n1] == record_type) { return cursor; }
        let n2 = record_next[n1];
        if (n2 == 0) { return 0; }
        if (records[n2] == record_type) { return n1; }
        let n3 = record_next[n2];
        if (n3 == 0) { return 0; }
        if (records[n3] == record_type) { return n2; }
        let n4 = record_next[n3];
        if (n4 == 0) { return 0; }
        if (records[n4] == record_type) { return n3; }
        let n5 = record_next[n4];
        if (n5 == 0) { return 0; }
        if (records[n5] == record_type) { return n4; }
        let n6 = record_next[n5];
        if (n6 == 0) { return 0; }
        if (records[n6] == record_type) { return n5; }
        let n7 = record_next[n6];
        if (n7 == 0) { return 0; }
        if (records[n7] == record_type) { return n6; }
        return 0;
    }
}
