// LuneTreasury - Registration payment and fee distribution for .lune DNS
//
// Compile:
//     trocto contracts/lune_dns/treasury.tc -o treasury.bin
//     trocto contracts/lune_dns/treasury.tc --emit-regol

contract LuneTreasury {
    state {
        owner: address,
        total_fees: u64,
        fee_recipient: u64,
        protocol_fee_percent: u64,
        min_registration_payment: u64,
    }

    event PaymentReceived {
        from: address,
        amount: u64,
        purpose: u64,
    }

    event FeeDistributed {
        amount: u64,
        recipient: u64,
    }

    init() {
        self.owner = sender();
        self.fee_recipient = sender();
        self.total_fees = 0;
        self.protocol_fee_percent = 250;
        self.min_registration_payment = 1000;
    }

    // Deposit LUNE for a specific purpose. Records the payment.
    pub fn deposit(purpose: u64) {
        let amount = caller_balance();
        require(amount > 0, 1);
        let fee = (amount * self.protocol_fee_percent) / 10000;
        self.total_fees += fee;
        emit PaymentReceived(sender(), amount, purpose);
    }

    // Withdraw accumulated fees. Only fee_recipient.
    pub fn withdraw(amount: u64) {
        require(sender() == self.fee_recipient, 2);
        require(amount > 0, 3);
        require(amount <= self.total_fees, 4);
        self.total_fees -= amount;
        pay(self.fee_recipient, amount);
        emit FeeDistributed(amount, self.fee_recipient);
    }

    // Update fee recipient. Only owner.
    pub fn set_fee_recipient(new_recipient: u64) {
        require(sender() == self.owner, 5);
        self.fee_recipient = new_recipient;
    }

    // Update protocol fee. Only owner. Max 1000 (10%).
    pub fn set_protocol_fee(new_fee_percent: u64) {
        require(sender() == self.owner, 5);
        require(new_fee_percent <= 1000, 6);
        self.protocol_fee_percent = new_fee_percent;
    }

    // Get treasury balance.
    pub fn get_balance() -> u64 {
        return self.total_fees;
    }

    // Get total fees collected.
    pub fn get_total_fees() -> u64 {
        return self.total_fees;
    }
}
