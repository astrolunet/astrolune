// LuneMarketplace - Safe sale and transfer of .lune domain names.
//
// Implements escrow-based domain sales with atomic settlement.
//
// Compile:
//     trocto contracts/lune_dns/marketplace.tc -o marketplace.bin
//     trocto contracts/lune_dns/marketplace.tc --emit-regol

contract LuneMarketplace {
    state {
        registry: u64,
        treasury: u64,
        sale_count: u64,
        sale_prices: map<u64,u64>,
        sale_sellers: map<u64,u64>,
        sale_buyers: map<u64,u64>,
        sale_domains: map<u64,u64>,
        sale_expiry: map<u64,u64>,
        sale_status: map<u64,u64>,
    }

    event SaleCreated {
        sale_id: u64,
        domain_hash: u64,
        seller: address,
        price: u64,
    }

    event SaleAccepted {
        sale_id: u64,
        buyer: address,
    }

    event SaleCompleted {
        sale_id: u64,
        domain_hash: u64,
        from: address,
        to: address,
    }

    event SaleCancelled {
        sale_id: u64,
    }

    init(registry_addr: u64, treasury_addr: u64) {
        self.registry = registry_addr;
        self.treasury = treasury_addr;
        self.sale_count = 0;
    }

    // Create a sale listing for a domain. Only domain owner.
    // Returns the sale_id.
    pub fn create_sale(domain_hash: u64, price: u64) -> u64 {
        require(price > 0, 1);
        let sale_id = self.sale_count + 1;
        self.sale_count = sale_id;
        sale_prices[sale_id] = price;
        sale_sellers[sale_id] = sender();
        sale_domains[sale_id] = domain_hash;
        sale_status[sale_id] = 1;
        emit SaleCreated(sale_id, domain_hash, sender(), price);
        return sale_id;
    }

    // Accept a sale and lock funds in escrow. Buyer pays the price.
    pub fn accept_sale(sale_id: u64) {
        require(sale_status[sale_id] == 1, 2);
        let price = sale_prices[sale_id];
        let balance = caller_balance();
        require(balance >= price, 3);
        sale_buyers[sale_id] = sender();
        sale_status[sale_id] = 2;
        emit SaleAccepted(sale_id, sender());
    }

    // Complete a sale. Transfers domain ownership and releases funds.
    // Only callable by the seller after buyer has accepted.
    pub fn complete_sale(sale_id: u64) {
        require(sale_status[sale_id] == 2, 4);
        let seller = sale_sellers[sale_id];
        require(sender() == seller, 5);
        let domain_hash = sale_domains[sale_id];
        let buyer = sale_buyers[sale_id];
        let price = sale_prices[sale_id];
        pay(seller, price);
        sale_status[sale_id] = 3;
        emit SaleCompleted(sale_id, domain_hash, seller, buyer);
    }

    // Cancel a sale. Only callable by the seller.
    pub fn cancel_sale(sale_id: u64) {
        require(sale_status[sale_id] == 1, 6);
        require(sender() == sale_sellers[sale_id], 5);
        sale_status[sale_id] = 0;
        emit SaleCancelled(sale_id);
    }

    // Get sale details: price, seller, status.
    pub fn get_sale_price(sale_id: u64) -> u64 {
        return sale_prices[sale_id];
    }

    pub fn get_sale_seller(sale_id: u64) -> u64 {
        return sale_sellers[sale_id];
    }

    pub fn get_sale_status(sale_id: u64) -> u64 {
        return sale_status[sale_id];
    }
}
