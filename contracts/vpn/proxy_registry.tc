// ProxyRegistry - on-chain registry for proxy and exit nodes in the Astrolune VPN.
//
// Tracks node capabilities, endpoints, reputation scores, staked deposits,
// and exit node status. Nodes must register and stake before participating
// in the network.
//
// Compile:
//     trocto contracts/vpn/proxy_registry.tc -o proxy_registry.bin
//     trocto contracts/vpn/proxy_registry.tc --emit-regol

contract ProxyRegistry {
    state {
        owner: address,
        node_count: u64,
        nodes: map<u64,u64>,
        node_capabilities: map<u64,u64>,
        node_endpoints: map<u64,u64>,
        node_deposits: map<u64,u64>,
        node_reputation: map<u64,u64>,
        exit_nodes: map<u64,u64>,
        node_uptime: map<u64,u64>,
        node_quality: map<u64,u64>,
        node_status: map<u64,u64>,
    }

    event NodeRegistered {
        node_id: u64,
        node_addr: address,
        capabilities: u64,
        deposit: u64,
    }

    event NodeUpdated {
        node_id: u64,
        capabilities: u64,
        endpoint: u64,
    }

    event NodeDeregistered {
        node_id: u64,
        refund: u64,
    }

    event ExitNodeEnabled {
        node_id: u64,
    }

    event ExitNodeDisabled {
        node_id: u64,
    }

    // Constructor: sets deployer as contract owner.
    init() {
        self.owner = sender();
        self.node_count = 0;
    }

    // Register a new proxy node. Caller must send a deposit.
    // capabilities: bitmask of supported features (1=ipv4, 2=ipv6, 4=socks5, 8=wireguard)
    // endpoint: encoded endpoint identifier (e.g. multiaddr hash)
    // Returns the node_id.
    pub fn register_node(capabilities: u64, endpoint: u64) -> u64 {
        require(capabilities != 0, 1);
        require(endpoint != 0, 2);
        let deposit = caller_balance();
        require(deposit > 0, 3);
        let node_id = self.node_count + 1;
        self.node_count = node_id;
        nodes[node_id] = sender();
        node_capabilities[node_id] = capabilities;
        node_endpoints[node_id] = endpoint;
        node_deposits[node_id] = deposit;
        node_reputation[node_id] = 100;
        node_uptime[node_id] = 100;
        node_quality[node_id] = 100;
        node_status[node_id] = 1;
        exit_nodes[node_id] = 0;
        emit NodeRegistered(node_id, sender(), capabilities, deposit);
        return node_id;
    }

    // Update node metadata. Only the node operator may call this.
    pub fn update_node(node_id: u64, capabilities: u64, endpoint: u64) {
        require(nodes[node_id] == sender(), 4);
        require(node_status[node_id] == 1, 5);
        require(capabilities != 0, 1);
        require(endpoint != 0, 2);
        node_capabilities[node_id] = capabilities;
        node_endpoints[node_id] = endpoint;
        emit NodeUpdated(node_id, capabilities, endpoint);
    }

    // Deregister a node and refund the deposit. Only the node operator may call.
    // Returns the refunded deposit amount.
    pub fn deregister_node(node_id: u64) -> u64 {
        require(nodes[node_id] == sender(), 4);
        require(node_status[node_id] == 1, 5);
        let refund = node_deposits[node_id];
        node_status[node_id] = 0;
        node_deposits[node_id] = 0;
        exit_nodes[node_id] = 0;
        if (refund > 0) {
            pay(sender(), refund);
        }
        emit NodeDeregistered(node_id, refund);
        return refund;
    }

    // Enable exit node capability for a node. Only the node operator may call.
    // Node must have the exit capability bit (16) set in its capabilities.
    pub fn enable_exit_node(node_id: u64) {
        require(nodes[node_id] == sender(), 4);
        require(node_status[node_id] == 1, 5);
        require(node_capabilities[node_id] & 16 == 16, 6);
        exit_nodes[node_id] = 1;
        emit ExitNodeEnabled(node_id);
    }

    // Disable exit node capability. Only the node operator may call.
    pub fn disable_exit_node(node_id: u64) {
        require(nodes[node_id] == sender(), 4);
        require(node_status[node_id] == 1, 5);
        exit_nodes[node_id] = 0;
        emit ExitNodeDisabled(node_id);
    }

    // Record uptime for a node. Only callable by contract owner.
    // uptime: percentage 0-100
    pub fn record_uptime(node_id: u64, uptime: u64) {
        require(sender() == self.owner, 7);
        require(node_status[node_id] == 1, 5);
        require(uptime <= 100, 8);
        node_uptime[node_id] = uptime;
    }

    // Record service quality for a node. Only callable by contract owner.
    // quality: score 0-100
    pub fn record_quality(node_id: u64, quality: u64) {
        require(sender() == self.owner, 7);
        require(node_status[node_id] == 1, 5);
        require(quality <= 100, 8);
        node_quality[node_id] = quality;
    }

    // Update reputation based on uptime and quality. Only callable by contract owner.
    // reputation = (uptime * 50 + quality * 50) / 100
    pub fn update_reputation(node_id: u64) {
        require(sender() == self.owner, 7);
        require(node_status[node_id] == 1, 5);
        let rep = (node_uptime[node_id] * 50 + node_quality[node_id] * 50) / 100;
        node_reputation[node_id] = rep;
    }

    // Get node address.
    pub fn get_node_addr(node_id: u64) -> address {
        return nodes[node_id];
    }

    // Get node capabilities bitmask.
    pub fn get_node_capability(node_id: u64) -> u64 {
        return node_capabilities[node_id];
    }

    // Get node endpoint.
    pub fn get_node_endpoint(node_id: u64) -> u64 {
        return node_endpoints[node_id];
    }

    // Get node deposit balance.
    pub fn get_node_deposit(node_id: u64) -> u64 {
        return node_deposits[node_id];
    }

    // Get node reputation score.
    pub fn get_node_reputation(node_id: u64) -> u64 {
        return node_reputation[node_id];
    }

    // Get node uptime percentage.
    pub fn get_node_uptime(node_id: u64) -> u64 {
        return node_uptime[node_id];
    }

    // Get node service quality score.
    pub fn get_node_quality(node_id: u64) -> u64 {
        return node_quality[node_id];
    }

    // Get node status (0=deregistered, 1=active).
    pub fn get_node_status(node_id: u64) -> u64 {
        return node_status[node_id];
    }

    // Check if a node is an exit node. Returns 1 if exit node, 0 otherwise.
    pub fn is_exit_node(node_id: u64) -> u64 {
        if (exit_nodes[node_id] == 1) {
            return 1;
        }
        return 0;
    }

    // Check if a node is active. Returns 1 if active, 0 otherwise.
    pub fn is_active(node_id: u64) -> u64 {
        if (node_status[node_id] == 1) {
            return 1;
        }
        return 0;
    }

    // Get total number of registered nodes.
    pub fn get_node_count() -> u64 {
        return self.node_count;
    }
}
